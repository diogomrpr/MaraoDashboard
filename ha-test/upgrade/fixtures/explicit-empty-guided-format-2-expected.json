          }
        ]
      },
      "wallbox": {
        "status_entity": "sensor.wallbox_status",
        "charging_power_entity": "sensor.wallbox_power",
        "current_control_entity": "input_number.wallbox_current",
        "pause_resume_entity": "switch.wallbox_pause"
      },
      "media": {
        "players": []
      }
    }
