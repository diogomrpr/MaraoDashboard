                "shortcuts": [
                  6,
                  12,
                  16
                ],
                "future_option": true
              },
              "icon": "mdi:ev-plug-type2"
            }
          ]
        },
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-5",
              "template": "hc_switch_card",
              "entity_id": "switch.wallbox_pause",
              "name": "Pause / Resume",
              "icon": "mdi:pause-circle",
              "name_key": "wallbox.pause_resume"
