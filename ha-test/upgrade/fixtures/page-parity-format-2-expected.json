          "entities": [
            {
              "id": "card-1",
              "entity_id": "sensor.house_power",
              "template": "hc_graph_card",
              "name": "Whole-home demand",
              "icon": "mdi:home-lightning-bolt",
              "future_card": 42,
              "variables": {
                "show_graph_fill": true,
                "show_graph_line": false,
                "show_icon": true,
                "future_option": {
                  "preserve": true
                },
                "history_popup": true,
                "popup_hash": "#energy-house-power"
              }
            }
          ]
        },
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-2",
              "template": "hc_energy_period_card",
              "entity_id": "sensor.month_energy",
              "name": "Month Power",
              "icon": "mdi:flash",
              "variables": {
                "period": "month",
                "popup_hash": "#energy-month-power"
              },
              "name_key": "energy.month_power"
            }
          ]
        },
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-3",
              "entity_id": "sensor.today_energy",
              "template": "hc_energy_period_card",
              "name": "Daily meter",
              "icon": "mdi:counter",
              "future_card": true,
              "variables": {
                "period": "day",
                "popup_hash": "#energy-today-power"
              }
            }
          ]
        },
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-4",
              "template": "hc_energy_period_card",
              "entity_id": "sensor.month_cost",
              "name": "Month Cost",
              "icon": "mdi:currency-eur",
              "variables": {
                "period": "month",
                "popup_hash": "#energy-month-cost"
              },
              "name_key": "energy.month_cost"
            }
          ]
        },
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-5",
              "entity_id": "sensor.today_cost",
              "template": "hc_energy_period_card",
              "name": "Daily spend",
              "icon": "mdi:cash",
              "future_card": true,
              "variables": {
                "period": "day",
                "popup_hash": "#energy-today-cost"
              }
            }
          ]
        },
        {
          "columns": 2,
          "entities": [
            {
              "id": "card-6",
              "template": "hc_toggle_graph_card",
              "entity_id": "sensor.heater_power",
              "name": "Heater Power",
              "icon": null,
              "variables": {
                "toggle_entity": "switch.heater"
              }
            }
          ]
        },
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-7",
              "entity_id": "sensor.dishwasher",
              "template": "hc_dishwasher_card",
              "name": "Dishwasher"
            }
          ]
        }
