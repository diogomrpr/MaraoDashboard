              "tap_action": {
                "action": "perform-action",
                "perform_action": "button.press",
                "target": {
                  "entity_id": "button.open_door"
                },
                "haptic": "heavy"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "energy",
      "name": "Energy",
