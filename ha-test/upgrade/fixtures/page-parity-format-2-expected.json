{
  "name": "Generated Test",
  "config_version": 2,
  "slug": "generated-test",
  "theme": "Marao Dashboard",
  "icon": "marao_dashboard:mountain",
  "landing_page": "overview",
  "pages": [
    {
      "id": "overview",
      "name": "Home",
      "name_key": "nav.home",
      "path": "overview",
      "icon": "mdi:home-variant",
      "output_path": "views/main/00-overview.yaml",
      "sections": [
        {
          "columns": 1,
          "entities": [
            {
              "id": "card-1",
              "template": "hc_weather_card",
              "entity_id": "weather.fixture",
              "variables": {
                "show_forecast": true
              }
            }
          ]
        },
        {
          "columns": 2,
          "entities": [
            {
              "template": "hc_entity_group_card",
              "id": "overview-lights",
              "name": "Lights",
              "icon": "mdi:lightbulb-group-outline",
              "entity_type": "light",
              "popup_filter": "active",
              "entities": [
                "light.living_room_main"
              ],
              "variables": {
                "popup_hash": "#overview-lights"
              },
              "name_key": "overview.lights"
            },
            {
              "template": "hc_entity_group_card",
              "id": "overview-blinds",
              "name": "Blinds",
              "icon": "mdi:window-shutter",
              "entity_type": "cover",
              "popup_filter": "all",
              "entities": [
                "cover.living_room_blind"
              ],
              "variables": {
                "popup_hash": "#overview-blinds"
              },
              "name_key": "overview.blinds"
            },
            {
              "template": "hc_entity_group_card",
              "id": "overview-climate",
              "name": "Climate",
              "icon": "mdi:thermostat",
              "entity_type": "climate",
              "popup_filter": "all",
              "entities": [
                "climate.living_room"
              ],
              "variables": {
                "popup_hash": "#overview-climate"
              },
              "name_key": "overview.climate"
            },
            {
              "id": "overview-maintenance",
              "template": "hc_entity_group_card",
              "name": "Maintenance",
              "name_key": "overview.maintenance",
              "icon": "mdi:wrench",
              "entity_type": "battery",
              "popup_filter": "all",
              "entities": [
                {
                  "entity_id": "sensor.fixture_battery",
                  "template": "hc_battery_card"
                }
              ],
              "variables": {
                "popup_hash": "#overview-maintenance"
              }
            },
            {
              "id": "card-6",
              "template": "hc_scene_collection_card",
              "name": "Scenes",
              "icon": "mdi:palette-outline",
              "entities": [
                "input_boolean.holiday_mode"
              ],
              "variables": {
                "popup_hash": "#overview-scenes"
              },
              "name_key": "overview.scenes"
            }
          ]
        }
      ]
    },
    {
      "id": "rooms",
      "name": "Rooms",
      "name_key": "nav.rooms",
      "path": "rooms",
      "icon": "mdi:sofa",
      "output_path": "views/main/02-rooms.yaml",
      "sections": [
        {
          "columns": 2,
          "entities": [
            {
              "id": "card-1",
              "template": "hc_room_card",
              "entity_id": "light.living_room_main",
              "name": "Living Room",
              "icon": "mdi:sofa-outline",
              "page": "room-living-room",
              "variables": {
                "light_entities": [
                  "light.living_room_main"
                ],
                "lights_target_entity": "light.living_room_main"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "security",
      "name": "Security",
      "name_key": "nav.security",
      "path": "security",
      "icon": "mdi:shield-home",
      "output_path": "views/main/01-security.yaml",
