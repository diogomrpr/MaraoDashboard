{
  "name": "marao-dashboard",
  "version": "0.22.2",
  "private": true,
  "description": "Marao Dashboard Home Assistant dashboard development tools",
  "scripts": {
    "setup": "npm ci",
    "build:editor": "node frontend_src/build-editor.cjs",
    "check:editor": "node frontend_src/build-editor.cjs --check",
    "build:hacs": "npm run build:editor && node frontend_src/build-native.cjs --frontend",
    "test:frontend": "node --test --test-concurrency=1 tests/frontend/*.test.js",
    "test:static": "npm run check:editor && npm run test:frontend && node frontend_src/build-hacs-dist.cjs && node --check ha-test/.cache/dist/custom_components/marao_dashboard/frontend/MaraoDashboard.js && node tests/validate-yaml.js",
    "test:python": "pytest --cov=custom_components.marao_dashboard --cov-report=term-missing",
    "test": "npm run test:affected",
    "test:ha:e2e": "node tests/test-ha-dashboard-e2e.js",
    "test:ha:alignment": "node tests/test-ha-card-alignment.js",
    "test:ha:rooms": "node tests/test-ha-room-cards.js",
    "test:ha:climate-layout": "node tests/test-ha-climate-layout.js",
    "test:ha:sliders": "node tests/test-ha-value-sliders.js",
    "test:ha:accessibility": "node tests/test-ha-dashboard-accessibility.js",
    "ha:preview:accessibility": "node tests/test-ha-dashboard-accessibility.js --preview",
    "verify:publish": "node tests/verify-publish.js",
    "verify:release": "node tests/verify-release.js",
    "preversion": "npm run test:affected -- --unit",
    "ha:sync": "node ha-test/prepare.js",
    "ha:preview": "node tests/preview-frontend.js",
    "ha:sync:dry-run": "node ha-test/prepare.js --dry-run",
    "test:ha:upgrade": "node tests/test-ha-upgrade.js",
    "test:affected": "node tests/verification.js",
    "test:full": "node tests/verification.js --full",
    "build:converter": "node frontend_src/build-native.cjs"
  },
  "devDependencies": {
    "chart.js": "4.5.1",
    "esbuild": "0.28.2",
    "monaco-editor": "0.56.0",
    "playwright": "1.61.1",
    "yaml": "2.7.0"
  }
}
