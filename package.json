{
  "name": "marao-dashboard",
  "version": "0.5.0",
  "private": true,
  "description": "Marao Dashboard Home Assistant dashboard development tools",
  "scripts": {
    "setup": "npm ci",
    "build:editor": "node scripts/build-editor.js",
    "check:editor": "node scripts/build-editor.js --check",
    "build:hacs": "npm run build:editor && node scripts/build-hacs-dist.js",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:static": "npm run check:editor && npm run test:frontend && npm run build:hacs && node --check dist/custom_components/marao_dashboard/frontend/MaraoDashboard.js && node scripts/validate-yaml.js",
    "test:python": "pytest --cov=custom_components.marao_dashboard --cov-report=term-missing",
    "test": "npm run test:static && npm run test:python",
    "test:ha:e2e": "node scripts/test-ha-dashboard-e2e.js",
    "test:ha:alignment": "node scripts/test-ha-card-alignment.js",
    "test:ha:accessibility": "node scripts/test-ha-dashboard-accessibility.js",
    "ha:preview:accessibility": "node scripts/test-ha-dashboard-accessibility.js --preview",
    "verify:publish": "npm test && npm run test:ha:e2e && npm run test:ha:accessibility",
    "preversion": "npm run verify:publish",
    "ha:sync": "npm run build:hacs && node scripts/sync-ha-local.js",
    "ha:sync:dry-run": "node scripts/sync-ha-local.js --dry-run"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "monaco-editor": "0.56.0",
    "playwright": "1.61.1",
    "yaml": "2.7.0"
  }
}
